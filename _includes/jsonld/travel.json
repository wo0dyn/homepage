{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "{{ page.title }}",
  "description": "{{ page.description | strip_html | strip }}",
  "url": "{{ site.url }}/{{ page.permalink }}",
  "author": {
    "@type": "Person",
    "@id": "{{ site.url }}/#person"
  },
  "mainEntity": {
    "@type": "ImageGallery",
    "name": "Travel Photos",
    "author": {
      "@id": "{{ site.url }}/#person"
    }
  }
}
