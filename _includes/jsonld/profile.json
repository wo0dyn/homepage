{
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "dateCreated": "2002-02-14",
  "dateModified": "{{ site.time | date_to_xmlschema }}",
  "mainEntity": {
    "@type": "Person",
    "@id": "{{ site.url }}/#person",
    "name": "{{ site.author.fullname }}",
    "alternateName": "{{ site.author.nickname }}",
    "gender": "male",
    "url": "{{ site.author.website }}",
    "image": "{{ site.author.gravatar }}",
    "email": "{{ site.author.email }}",
    "sameAs": [
      {%- for medium in site.author.social %}
      "{{ medium[1].url }}"{% unless forloop.last %},{% endunless %}
      {%- endfor %}
    ],
    "jobTitle": "{{ site.author.title }}",
    "knowsLanguage": ["fr", "en"],
    "worksFor": {
      "@type": "Corporation",
      "name": "{{ site.author.company }}"
    }
  }
}
